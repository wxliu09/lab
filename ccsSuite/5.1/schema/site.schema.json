{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ccs-site.schema.json",
  "title": "CCS 候選場址模型（Taiwan CCS WebGIS site model）",
  "description": "單一場址的定義：位置、模型範圍、地層柱、構造、溫壓／應力條件、注入井與評估預設值。座標系：場址中心為原點的局部座標（x 東、y 北，公尺）；深度為海平面下（公尺，正值向下）。若提供 horizons（實測層面格網），則以其取代程序式構造建模。",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "location",
    "model",
    "stratigraphy",
    "conditions"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "唯一識別碼（匯入時同 id 覆蓋）"
    },
    "name": {
      "type": "string"
    },
    "nameEn": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "saline_aquifer",
        "depleted_gas"
      ]
    },
    "setting": {
      "type": "string",
      "enum": [
        "onshore",
        "coastal",
        "offshore"
      ],
      "default": "onshore"
    },
    "region": {
      "type": "string"
    },
    "waterDepth": {
      "type": "number",
      "minimum": 0,
      "description": "海域場址水深（m）"
    },
    "dataStatus": {
      "type": "string",
      "enum": [
        "simulated",
        "imported",
        "measured"
      ],
      "default": "imported"
    },
    "description": {
      "type": "string"
    },
    "basis": {
      "type": "string",
      "description": "地質假設／資料來源說明"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "風險旗標（顯示於篩選檢核表）"
    },
    "location": {
      "type": "object",
      "required": [
        "lon",
        "lat"
      ],
      "properties": {
        "lon": {
          "type": "number",
          "minimum": 118,
          "maximum": 123
        },
        "lat": {
          "type": "number",
          "minimum": 21,
          "maximum": 26.5
        }
      },
      "description": "WGS84；作為模型原點（局部座標 (0,0)）"
    },
    "model": {
      "type": "object",
      "required": [
        "extent",
        "depthMax"
      ],
      "properties": {
        "extent": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 500,
            "maximum": 200000
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[Lx, Ly] 公尺（東西 × 南北）"
        },
        "grid": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 8,
            "maximum": 200
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            64,
            64
          ],
          "description": "[nx, ny] 格網切分數（頂點數為 (nx+1)(ny+1)）"
        },
        "depthMax": {
          "type": "number",
          "minimum": 200,
          "maximum": 20000,
          "description": "模型底深度（m）"
        }
      }
    },
    "surface": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "onshore",
            "coastal",
            "offshore"
          ]
        },
        "elevation": {
          "type": "number",
          "description": "陸域基準高程（m）"
        },
        "relief": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fold": {
                "type": "integer"
              },
              "dome": {
                "type": "integer"
              },
              "amplitude": {
                "type": "number"
              }
            }
          },
          "description": "地形起伏：跟隨某褶皺／穹隆的振幅（m）"
        },
        "coastRamp": {
          "type": "number",
          "description": "海岸場址：地形自海岸線向內陸達到基準高程的距離（m）"
        },
        "shoreElevation": {
          "type": "number"
        },
        "bathymetry": {
          "type": "object",
          "properties": {
            "slope": {
              "type": "number"
            },
            "maxDepth": {
              "type": "number"
            }
          },
          "description": "海岸場址：海床坡度（m/m）與最大水深"
        },
        "waterDepth": {
          "type": "number",
          "description": "海域場址：固定水深（m）"
        }
      }
    },
    "stratigraphy": {
      "type": "array",
      "minItems": 2,
      "description": "由淺至深；第一層頂面即地表／海床",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "top",
          "porosity",
          "permeability"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "age": {
            "type": "string"
          },
          "lithology": {
            "type": "string",
            "enum": [
              "gravel-sand",
              "conglomerate",
              "sandstone",
              "sand-shale",
              "shale",
              "mudstone",
              "coal-sand",
              "marine-clastics",
              "basement"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "reservoir",
              "secondary",
              "seal",
              "overburden",
              "basement"
            ]
          },
          "top": {
            "type": "number",
            "description": "參考頂面深度（m，於模型原點、未變形狀態）"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "porosity": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.6
          },
          "permeability": {
            "type": "number",
            "minimum": 0,
            "description": "mD"
          },
          "ntg": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "淨毛比"
          },
          "vshale": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "泥質含量（SGR 計算用）"
          },
          "entryPressure": {
            "type": "number",
            "minimum": 0,
            "description": "CO2–鹵水毛細進入壓力（MPa）"
          },
          "thicknessMods": {
            "type": "array",
            "description": "側向厚度變化（乘數）",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "wedge",
                    "linear",
                    "fold",
                    "dome"
                  ]
                },
                "fault": {
                  "type": "integer"
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "hw",
                    "fw"
                  ]
                },
                "factor": {
                  "type": "number"
                },
                "lambda": {
                  "type": "number"
                },
                "azimuth": {
                  "type": "number"
                },
                "rate": {
                  "type": "number",
                  "description": "每 km 的厚度變化率"
                },
                "fold": {
                  "type": "integer"
                },
                "dome": {
                  "type": "integer"
                }
              }
            }
          },
          "phiSd": {
            "type": "number",
            "description": "孔隙率標準差（屬性場）；未給時依岩性預設"
          },
          "kSd": {
            "type": "number",
            "description": "log10 滲透率標準差（屬性場）"
          },
          "trend": {
            "type": "string",
            "enum": [
              "uniform",
              "fining",
              "coarsening"
            ],
            "description": "垂向粒序趨勢"
          },
          "grClean": {
            "type": "number"
          },
          "grShale": {
            "type": "number"
          },
          "rhoMa": {
            "type": "number",
            "description": "基質密度 g/cm³"
          },
          "vpMa": {
            "type": "number",
            "description": "基質縱波速度 m/s"
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "properties": {
        "regionalDip": {
          "type": "object",
          "properties": {
            "dip": {
              "type": "number"
            },
            "azimuth": {
              "type": "number",
              "description": "傾向方位（自北順時針，層面朝該方向變深）"
            },
            "through": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "folds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "axisAzimuth",
              "amplitude",
              "halfWidth"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "nameEn": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "anticline",
                  "syncline"
                ]
              },
              "axisAzimuth": {
                "type": "number"
              },
              "through": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "amplitude": {
                "type": "number"
              },
              "halfWidth": {
                "type": "number"
              },
              "shape": {
                "type": "string",
                "enum": [
                  "cosine",
                  "gaussian"
                ]
              },
              "depthProfile": {
                "$ref": "#/definitions/depthProfile"
              },
              "alongTaper": {
                "$ref": "#/definitions/alongTaper"
              }
            }
          }
        },
        "domes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "center",
              "radii",
              "amplitude"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "dome",
                  "diapir",
                  "basementHigh"
                ]
              },
              "center": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "radii": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "azimuth": {
                "type": "number"
              },
              "amplitude": {
                "type": "number"
              },
              "depthProfile": {
                "$ref": "#/definitions/depthProfile"
              },
              "rim": {
                "type": "object",
                "description": "邊緣向斜（抽離）",
                "properties": {
                  "amplitude": {
                    "type": "number"
                  },
                  "radiusFactor": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "depthProfile": {
                    "$ref": "#/definitions/depthProfile"
                  }
                }
              }
            }
          }
        },
        "faults": {
          "type": "array",
          "description": "假設模型內斷層彼此不相交",
          "items": {
            "type": "object",
            "required": [
              "type",
              "strike",
              "dip",
              "throw"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "nameEn": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "normal",
                  "reverse",
                  "thrust"
                ]
              },
              "strike": {
                "type": "number",
                "minimum": 0,
                "maximum": 360,
                "description": "走向方位；傾向為走向 +90°（右手定則），上盤位於傾向側"
              },
              "dip": {
                "type": "number",
                "minimum": 5,
                "maximum": 90
              },
              "through": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "斷層面在深度 zRef 通過的點"
              },
              "zRef": {
                "type": "number",
                "default": 0
              },
              "throw": {
                "type": "number",
                "minimum": 0,
                "description": "最大垂直分離量（m）"
              },
              "tipDepth": {
                "type": "number",
                "description": "斷層向上尖滅深度"
              },
              "fullThrowDepth": {
                "type": "number",
                "description": "達最大斷距的深度"
              },
              "throwProfile": {
                "type": "string",
                "enum": [
                  "smooth",
                  "linear"
                ]
              },
              "bottomDepth": {
                "type": "number"
              },
              "listric": {
                "type": "object",
                "properties": {
                  "detachDepth": {
                    "type": "number"
                  },
                  "minDip": {
                    "type": "number"
                  }
                }
              },
              "rollover": {
                "type": "object",
                "properties": {
                  "lambda": {
                    "type": "number",
                    "description": "上盤滾覆衰減距離（m）"
                  }
                }
              },
              "alongTaper": {
                "$ref": "#/definitions/alongTaper"
              },
              "cuts": {
                "type": "boolean",
                "default": true,
                "description": "false 時僅顯示斷層面、不切割地層"
              }
            }
          }
        },
        "basementTruncation": {
          "type": "boolean",
          "description": "true：基盤以上各層面以基盤頂面截切（超覆尖滅）"
        }
      }
    },
    "conditions": {
      "type": "object",
      "required": [
        "surfaceTemp",
        "tempGradient",
        "pressureGradient",
        "fractureGradient",
        "salinity",
        "stress"
      ],
      "properties": {
        "surfaceTemp": {
          "type": "number",
          "description": "°C（地表或海床）"
        },
        "tempGradient": {
          "type": "number",
          "description": "°C/km"
        },
        "pressureGradient": {
          "type": "number",
          "description": "靜水壓梯度 MPa/km"
        },
        "overpressure": {
          "type": "object",
          "properties": {
            "startDepth": {
              "type": "number"
            },
            "gradient": {
              "type": "number"
            }
          }
        },
        "fractureGradient": {
          "type": "number",
          "description": "MPa/km"
        },
        "maxBhpFraction": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 1
        },
        "salinity": {
          "type": "number",
          "description": "ppm TDS"
        },
        "stress": {
          "type": "object",
          "required": [
            "svGradient",
            "shmaxRatio",
            "shminRatio",
            "shmaxAzimuth"
          ],
          "properties": {
            "svGradient": {
              "type": "number",
              "description": "MPa/km"
            },
            "shmaxRatio": {
              "type": "number"
            },
            "shminRatio": {
              "type": "number"
            },
            "shmaxAzimuth": {
              "type": "number"
            }
          }
        },
        "depletion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "枯竭氣田：現況壓力／原始壓力"
        },
        "gasSaturation": {
          "type": "number"
        },
        "recoveryFactor": {
          "type": "number"
        }
      }
    },
    "wells": {
      "type": "array",
      "description": "井：type=injection 為注入井（第一口為評估用井）；observation 為觀測井。target 指定射孔層位（reservoir / aboveSeal / 地層名稱），或直接給 depth 與 perf。",
      "items": {
        "type": "object",
        "required": [
          "name",
          "x",
          "y"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "injection",
              "observation"
            ],
            "default": "injection"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "depth": {
            "type": "number",
            "description": "井底深度（m）"
          },
          "perf": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "射孔段 [頂, 底]（m）"
          },
          "target": {
            "type": "string",
            "description": "reservoir｜aboveSeal｜地層名稱；未給 depth/perf 時據此推算"
          },
          "deviation": {
            "type": "object",
            "properties": {
              "east": {
                "type": "number"
              },
              "north": {
                "type": "number"
              }
            },
            "description": "斜井井底相對井口位移（m）"
          },
          "note": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "description": "評估預設值（皆可於介面調整）",
      "properties": {
        "reservoir": {
          "type": "integer"
        },
        "injectionRate": {
          "type": "number",
          "description": "Mt CO2/yr"
        },
        "years": {
          "type": "number"
        },
        "efficiency": {
          "type": "number"
        },
        "closureFill": {
          "type": "number"
        },
        "swirr": {
          "type": "number"
        },
        "sgr": {
          "type": "number"
        },
        "krco2": {
          "type": "number"
        },
        "rockCompressibility": {
          "type": "number"
        },
        "brineCompressibility": {
          "type": "number"
        },
        "wellRadius": {
          "type": "number"
        },
        "waterInvasion": {
          "type": "number"
        },
        "sgrThreshold": {
          "type": "number"
        },
        "friction": {
          "type": "number"
        },
        "cohesion": {
          "type": "number"
        },
        "maxBhpFraction": {
          "type": "number"
        },
        "postInjectionYears": {
          "type": "number"
        },
        "startYear": {
          "type": "integer",
          "description": "注入起始年（時間軸顯示用）"
        },
        "phiCut": {
          "type": "number",
          "description": "屬性場容積之孔隙率下限"
        },
        "vshCut": {
          "type": "number",
          "description": "屬性場容積之泥質含量上限"
        }
      }
    },
    "horizons": {
      "type": "array",
      "description": "實測層面格網；長度須為 stratigraphy.length + 1（地表、各層頂面、模型底）",
      "items": {
        "type": "object",
        "required": [
          "name",
          "z"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "z": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "(nx+1)(ny+1) 個深度值，列優先：index = j*(nx+1)+i，i 東向、j 北向，自 (-Lx/2, -Ly/2) 起"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "monitors": {
      "type": "array",
      "description": "地表／海底監測站（MMV）",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "flux",
              "seismic",
              "water",
              "insar",
              "pressure"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "vectors": {
      "type": "array",
      "description": "向量圖徵（許可區、管線、河川等）；points 為局部座標（m），或以 lonlat 給 WGS84 座標",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "license",
              "pipeline",
              "river",
              "road",
              "boundary",
              "other"
            ]
          },
          "color": {
            "type": "string"
          },
          "closed": {
            "type": "boolean"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "lonlat": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "hetero": {
      "type": "object",
      "description": "屬性場非均質尺度（m）",
      "properties": {
        "major": {
          "type": "number"
        },
        "minor": {

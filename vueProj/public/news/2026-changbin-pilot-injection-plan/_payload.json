[{"data":1,"prerenderedAt":38},["ShallowReactive",2],{"news-2026-changbin-pilot-injection-plan":3,"news-order":16},{"id":4,"slug":5,"title":6,"category":7,"publishedAt":8,"summary":9,"content":10,"pinned":11,"tags":12},"news-0006","2026-changbin-pilot-injection-plan","彰濱鹽水層試驗場址注儲試驗規劃說明會","event","2026-08-25T02:00:00Z","本中心將於 9 月 20 日於彰化縣線西鄉舉辦說明會，說明彰濱試驗場址的注儲試驗規劃、監測機制與民眾參與管道。","\u003Cp>為使地方民眾了解彰濱鹽水層試驗場址的規劃內容，本中心將於 115 年 9 月 20 日（星期日）上午 10 時，於彰化縣線西鄉公所三樓會議室舉辦說明會。\u003C\u002Fp>\u003Cp>說明會將介紹：\u003C\u002Fp>\u003Cul>\u003Cli>地質碳封存原理與國際案例\u003C\u002Fli>\u003Cli>彰濱場址地質條件與安全評估結果\u003C\u002Fli>\u003Cli>注儲試驗期間之地下水、土壤氣體與微震監測機制\u003C\u002Fli>\u003Cli>民眾意見反映管道\u003C\u002Fli>\u003C\u002Ful>\u003Cp>歡迎地方民眾踴躍參加，無需事先報名。\u003C\u002Fp>",true,[13,14,15],"彰濱","說明會","注儲試驗",[17,18,22,26,30,34],{"slug":5,"title":6,"publishedAt":8},{"slug":19,"title":20,"publishedAt":21},"2026-tx01-capacity-update","臺西盆地北區潛力區封存容量評估更新","2026-06-02T07:30:00Z",{"slug":23,"title":24,"publishedAt":25},"2026-platform-launch","地質碳封存潛力區位資訊平臺正式上線","2026-03-01T01:00:00Z",{"slug":27,"title":28,"publishedAt":29},"2025-tiehchenshan-monitoring-report","鐵砧山注儲試驗場址 2025 年度監測報告發布","2025-12-15T03:00:00Z",{"slug":31,"title":32,"publishedAt":33},"2025-yunlin-offshore-survey-start","雲林外海二維震測補測作業啟動","2025-10-01T02:00:00Z",{"slug":35,"title":36,"publishedAt":37},"2025-ccs-open-data-release","潛力區地質資料開放下載","2025-06-10T02:00:00Z",1790754767449]
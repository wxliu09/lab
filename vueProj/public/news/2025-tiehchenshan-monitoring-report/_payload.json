[{"data":1,"prerenderedAt":37},["ShallowReactive",2],{"news-2025-tiehchenshan-monitoring-report":3,"news-order":15},{"id":4,"slug":5,"title":6,"category":7,"publishedAt":8,"summary":9,"content":10,"pinned":11,"tags":12},"news-0003","2025-tiehchenshan-monitoring-report","鐵砧山注儲試驗場址 2025 年度監測報告發布","publication","2025-12-15T03:00:00Z","鐵砧山試驗場址完成第三年環境監測，地下水水質、土壤氣體通量與微震活動均在基線範圍內。","\u003Cp>鐵砧山枯竭氣田注儲試驗場址 2025 年度監測報告已完成，監測項目包含：\u003C\u002Fp>\u003Cul>\u003Cli>淺層地下水水位與水質（每月）\u003C\u002Fli>\u003Cli>土壤 CO₂ 通量（每季）\u003C\u002Fli>\u003Cli>微震監測（連續）\u003C\u002Fli>\u003Cli>注儲井井下壓力與溫度（連續）\u003C\u002Fli>\u003C\u002Ful>\u003Cp>各項監測結果均在注儲前建立之基線變動範圍內，未觀測到異常訊號。完整報告可於資料下載專區取得。\u003C\u002Fp>",false,[13,14],"鐵砧山","監測報告",[16,20,24,28,29,33],{"slug":17,"title":18,"publishedAt":19},"2026-changbin-pilot-injection-plan","彰濱鹽水層試驗場址注儲試驗規劃說明會","2026-08-25T02:00:00Z",{"slug":21,"title":22,"publishedAt":23},"2026-tx01-capacity-update","臺西盆地北區潛力區封存容量評估更新","2026-06-02T07:30:00Z",{"slug":25,"title":26,"publishedAt":27},"2026-platform-launch","地質碳封存潛力區位資訊平臺正式上線","2026-03-01T01:00:00Z",{"slug":5,"title":6,"publishedAt":8},{"slug":30,"title":31,"publishedAt":32},"2025-yunlin-offshore-survey-start","雲林外海二維震測補測作業啟動","2025-10-01T02:00:00Z",{"slug":34,"title":35,"publishedAt":36},"2025-ccs-open-data-release","潛力區地質資料開放下載","2025-06-10T02:00:00Z",1790754764934]
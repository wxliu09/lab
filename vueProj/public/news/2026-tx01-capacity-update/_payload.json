[{"data":1,"prerenderedAt":37},["ShallowReactive",2],{"news-2026-tx01-capacity-update":3,"news-order":15},{"id":4,"slug":5,"title":6,"category":7,"publishedAt":8,"summary":9,"content":10,"pinned":11,"tags":12},"news-0005","2026-tx01-capacity-update","臺西盆地北區潛力區封存容量評估更新","announcement","2026-06-02T07:30:00Z","依據 2019 年二維震測重新解釋成果，臺西盆地北區鹽水層封存潛力更新為 3,200 百萬公噸。","\u003Cp>本中心完成臺西盆地北區（TX-01）二維震測資料重新解釋，儲集層桂竹林層砂岩分布範圍較先前評估擴大約 12%，封存潛力由 2,850 百萬公噸更新為 3,200 百萬公噸。\u003C\u002Fp>\u003Cp>本次評估採用美國能源部（US DOE）體積法，效率係數取 2%。詳細評估方法與參數請參閱資料下載專區之技術報告。\u003C\u002Fp>",false,[13,14],"臺西盆地","容量評估",[16,20,21,25,29,33],{"slug":17,"title":18,"publishedAt":19},"2026-changbin-pilot-injection-plan","彰濱鹽水層試驗場址注儲試驗規劃說明會","2026-08-25T02:00:00Z",{"slug":5,"title":6,"publishedAt":8},{"slug":22,"title":23,"publishedAt":24},"2026-platform-launch","地質碳封存潛力區位資訊平臺正式上線","2026-03-01T01:00:00Z",{"slug":26,"title":27,"publishedAt":28},"2025-tiehchenshan-monitoring-report","鐵砧山注儲試驗場址 2025 年度監測報告發布","2025-12-15T03:00:00Z",{"slug":30,"title":31,"publishedAt":32},"2025-yunlin-offshore-survey-start","雲林外海二維震測補測作業啟動","2025-10-01T02:00:00Z",{"slug":34,"title":35,"publishedAt":36},"2025-ccs-open-data-release","潛力區地質資料開放下載","2025-06-10T02:00:00Z",1790754764934]
:173,"depthTopM":174,"depthBottomM":175,"thicknessM":176,"porosityPct":177,"permeabilityMd":178,"capacityMtCo2":174,"capacityMethod":132,"areaKm2":179,"summary":180,"description":181,"geometry":182,"publishStatus":158,"createdAt":201,"updatedAt":202,"createdBy":161,"updatedBy":203,"centroid":204,"wellCount":12,"surveyCount":12},"zone-tx-02","TX-02","臺西盆地中區鹽水層","Taixi Basin Central Saline Aquifer","assessing","雲林彰化外海","觀音山砂岩","打鹿頁岩",2100,2750,650,17.8,95,1320,"臺西盆地中段的中新世砂岩儲集層，尚待補充震測資料確認蓋層連續性。","本區儲集層為觀音山砂岩，蓋層為打鹿頁岩。既有資料以 1980 年代油氣探勘震測為主，解析度有限，目前列為評估中，待新一期二維震測補測後更新容量估算。",{"type":25,"coordinates":183},[184],[185,188,191,194,197,200],[186,187],119.88,23.8,[189,190],120.2,23.78,[192,193],120.26,24.12,[195,196],119.96,24.14,[198,199],119.84,23.98,[186,187],"2022-03-14T02:10:00Z","2026-04-18T01:20:00Z","u-003",{"lng":205,"lat":206},120.05000000000001,23.96,{"id":208,"code":209,"name":210,"nameEn":211,"type":119,"status":170,"setting":121,"region":212,"basin":213,"reservoirFormation":214,"caprockFormation":215,"depthTopM":216,"depthBottomM":217,"thicknessM":218,"porosityPct":219,"permeabilityMd":220,"capacityMtCo2":221,"capacityMethod":132,"areaKm2":222,"summary":223,"description":224,"geometry":225,"publishStatus":158,"createdAt":244,"updatedAt":245,"createdBy":161,"updatedBy":161,"centroid":246,"wellCount":12,"surveyCount":12},"zone-tn-01","TN-01","臺南盆地西南海域鹽水層","Tainan Basin Southwest Offshore Saline Aquifer","臺南高雄外海","臺南盆地","南莊層砂岩","古亭坑層",2400,3100,700,15.6,70,1150,960,"南部海域潛力區，古亭坑層泥岩厚度大、封閉性佳，惟構造活動性需進一步評估。","本區位於臺南盆地西南側海域，蓋層古亭坑層為厚層泥岩，區域封閉性優良。惟鄰近區域斷層與泥貫入體發育，須以三維震測與地震活動度分析確認構造穩定性後方能提升評估等級。",{"type":25,"coordinates":226},[227],[228,230,233,236,238,241,243],[152,229],22.7,[231,232],120.25,22.68,[234,235],120.32,22.95,[149,237],23.22,[239,240],119.92,23.18,[186,242],22.9,[152,229],"2023-02-27T01:00:00Z","2026-03-09T03:15:00Z",{"lng":247,"lat":235},120.1,{"id":249,"code":250,"name":251,"nameEn":252,"type":119,"status":170,"setting":121,"region":253,"basin":123,"reservoirFormation":124,"caprockFormation":125,"depthTopM":254,"depthBottomM":255,"thicknessM":256,"porosityPct":257,"permeabilityMd":258,"capacityMtCo2":259,"capacityMethod":132,"areaKm2":260,"summary":261,"description":262,"geometry":263,"publishStatus":158,"createdAt":278,"updatedAt":279,"createdBy":161,"updatedBy":161,"centroid":280,"wellCount":12,"surveyCount":12},"zone-tc-01","TC-01","臺中港外海鹽水層","Taichung Port Offshore Saline Aquifer","臺中外海",1950,2500,550,19.1,120,680,410,"鄰近臺中港工業區排放源，運輸距離短，為近岸海域的優先評估區。","本區位於臺中港西側近岸海域，鄰近大型排放源，具備管線運輸優勢。儲集層與彰濱場址同屬桂竹林層，2022 年完成二維震測補測，目前進行構造解釋與容量評估。",{"type":25,"coordinates":264},[265],[266,268,271,273,275,277],[267,141],120.3,[269,270],120.48,24.22,[272,156],120.5,[234,274],24.48,[146,276],24.35,[267,141],"2022-11-08T06:00:00Z","2026-05-30T02:45:00Z",{"lng":281,"lat":282},120.39,24.34,{"id":284,"code":285,"name":286,"nameEn":287,"type":119,"status":288,"setting":289,"region":290,"basin":123,"reservoirFormation":124,"caprockFormation":125,"depthTopM":291,"depthBottomM":292,"thicknessM":218,"porosityPct":293,"permeabilityMd":294,"capacityMtCo2":295,"capacityMethod":296,"areaKm2":297,"summary":298,"description":299,"geometry":300,"publishStatus":158,"createdAt":316,"updatedAt":317,"createdBy":161,"updatedBy":161,"centroid":318,"wellCount":321,"surveyCount":322},"zone-ch-01","CH-01","彰濱鹽水層試驗場址","Changbin Saline Aquifer Pilot Site","pilot","mixed","彰化縣",2350,3050,16.2,60,85,"體積法（場址尺度，效率係數 4%）",32,"陸域小規模注儲試驗場址，已完成探勘井與監測井，具完整岩心與井測資料。","彰濱試驗場址位於彰化沿海工業區，目標儲集層為桂竹林層砂岩，頂深約 2,350 公尺。場址已完成一口探勘井（CHB-1）與一口監測井（CHB-2），取得完整岩心試驗、井測與三維震測資料，並建立地下水與土壤氣體監測基線，作為後續小規模注儲試驗之依據。",{"type":25,"coordinates":301},[302],[303,306,309,311,313,315],[304,305],120.36,24.07,[307,308],120.44,24.06,[310,193],120.46,[312,144],120.4,[314,193],120.35,[304,305],"2021-09-01T03:00:00Z","2026-08-21T09:12:00Z",{"lng":319,"lat":320},120.405,24.104999999999997,3,4,{"id":324,"code":325,"name":326,"nameEn":327,"type":328,"status":288,"setting":329,"region":330,"basin":331,"reservoirFormation":332,"caprockFormation":333,"depthTopM":334,"depthBottomM":335,"thicknessM":128,"porosityPct":336,"permeabilityMd":337,"capacityMtCo2":338,"capacityMethod":339,"areaKm2":340,"summary":341,"description":342,"geometry":343,"publishStatus":158,"createdAt":358,"updatedAt":359,"createdBy":161,"updatedBy":161,"centroid":360,"wellCount":30,"surveyCount":30},"zone-ml-01","ML-01","鐵砧山枯竭氣田","Tiehchenshan Depleted Gas Field","depleted_field","onshore","苗栗縣","西部麓山帶","木山層","大寮層頁岩",2800,3600,12.4,25,9,"物質平衡法（依累積產氣量推估）",18,"已開發多年的陸域氣田，構造封閉性經長期生產驗證，適合作為注儲試驗場址。","鐵砧山氣田為背斜構造封閉，儲集層為漸新世至中新世木山層砂岩，蓋層為大寮層頁岩。氣田歷經數十年生產，構造封閉性已獲驗證，且既有井場與管線設施可再利用，作為 CO₂ 注儲試驗場址具成本優勢。",{"type":25,"coordinates":344},[345],[346,349,351,354,357],[347,348],120.65,24.44,[350,348],120.72,[352,353],120.73,24.5,[355,356],120.66,24.51,[347,348],"2021-09-01T03:10:00Z","2026-07-11T08:00:00Z",{"lng":361,"lat":362},120.69,24.475,{"id":364,"code":365,"name":366,"nameEn":367,"type":328,"status":120,"setting":329,"region":330,"basin":331,"reservoirFormation":332,"caprockFormation":173,"depthTopM":127,"depthBottomM":131,"thicknessM":368,"porosityPct":369,"permeabilityMd":340,"capacityMtCo2":53,"capacityMethod":339,"areaKm2":370,"summary":371,"description":372,"geometry":373,"publishStatus":158,"createdAt":388,"updatedAt":389,"createdBy":161,"updatedBy":161,"centroid":390,"wellCount":12,"surveyCount":393},"zone-ml-02","ML-02","永和山氣田","Yunghoshan Gas Field",600,11.8,14,"陸域枯竭氣田，儲量規模小但地質資料完整，可作為監測技術驗證場址。","永和山氣田位於苗栗頭份至造橋一帶，為狹長背斜構造。氣田已進入枯竭階段，既有鑽井資料完整，適合驗證注儲監測技術；惟儲存容量有限，定位為技術驗證而非商業規模場址。",{"type":25,"coordinates":374},[375],[376,379,381,384,387],[377,378],120.83,24.61,[380,378],120.9,[382,383],120.91,24.67,[385,386],120.84,24.68,[377,378],"2022-01-20T02:00:00Z","2025-12-03T06:40:00Z",{"lng":391,"lat":392},120.87,24.645,0,{"id":395,"code":396,"name":397,"nameEn":398,"type":119,"status":399,"setting":329,"region":400,"basin":401,"reservoirFormation":402,"caprockFormation":403,"depthTopM":368,"depthBottomM":404,"thicknessM":405,"porosityPct":40
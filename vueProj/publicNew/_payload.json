[{"data":1,"prerenderedAt":383},["ShallowReactive",2],{"home-stats":3,"home-zones":38,"home-news":347},{"zoneCount":4,"totalCapacityMtCo2":5,"wellCount":6,"surveyCount":7,"testCount":8,"documentCount":4,"lastUpdatedAt":9,"capacityByType":10,"capacityByRegion":19},7,7230,12,11,22,"2026-08-21T09:12:00Z",[11,15],{"type":12,"count":13,"capacityMtCo2":14},"saline_aquifer",5,7215,{"type":16,"count":17,"capacityMtCo2":18},"depleted_field",2,15,[20,24,27,30,33,36],{"region":21,"count":22,"capacityMtCo2":23},"彰化外海",1,3200,{"region":25,"count":22,"capacityMtCo2":26},"雲林彰化外海",2100,{"region":28,"count":22,"capacityMtCo2":29},"臺南高雄外海",1150,{"region":31,"count":22,"capacityMtCo2":32},"臺中外海",680,{"region":34,"count":22,"capacityMtCo2":35},"彰化縣",85,{"region":37,"count":17,"capacityMtCo2":18},"苗栗縣",{"items":39,"page":22,"pageSize":345,"total":346},[40,89,129,168,201,238,276,308],{"id":41,"code":42,"name":43,"nameEn":44,"type":12,"status":45,"setting":46,"region":21,"basin":47,"reservoirFormation":48,"caprockFormation":49,"depthTopM":50,"depthBottomM":51,"thicknessM":52,"porosityPct":53,"permeabilityMd":54,"capacityMtCo2":23,"capacityMethod":55,"areaKm2":56,"summary":57,"description":58,"geometry":59,"publishStatus":82,"createdAt":83,"updatedAt":84,"createdBy":85,"updatedBy":85,"centroid":86,"wellCount":17,"surveyCount":17},"zone-tx-01","TX-01","臺西盆地北區鹽水層","Taixi Basin North Saline Aquifer","potential","offshore","臺西盆地","桂竹林層","錦水頁岩",1800,2600,800,20.5,150,"體積法（US DOE 方法，效率係數 2%）",1850,"西部海域深層鹽水層，儲集層厚度大、蓋層連續，為目前評估規模最大的潛力區。","本區位於彰化外海臺西盆地北側，儲集層為中新世桂竹林層砂岩，上覆錦水頁岩作為區域性蓋層。根據既有二維震測與探勘井資料，儲集層頂深約 1,800 公尺，平均孔隙率約 20%，具備良好的注儲條件。後續規劃補充三維震測以精確界定構造封閉範圍。",{"type":60,"coordinates":61},"Polygon",[62],[63,66,69,72,75,78,81],[64,65],119.9,24.2,[67,68],120.18,24.15,[70,71],120.28,24.4,[73,74],120.22,24.7,[76,77],119.95,24.72,[79,80],119.82,24.45,[64,65],"published","2022-03-14T02:00:00Z","2026-06-02T07:30:00Z","u-002",{"lng":87,"lat":88},120.05,24.435,{"id":90,"code":91,"name":92,"nameEn":93,"type":12,"status":94,"setting":46,"region":25,"basin":47,"reservoirFormation":95,"caprockFormation":96,"depthTopM":26,"depthBottomM":97,"thicknessM":98,"porosityPct":99,"permeabilityMd":100,"capacityMtCo2":26,"capacityMethod":55,"areaKm2":101,"summary":102,"description":103,"geometry":104,"publishStatus":82,"createdAt":123,"updatedAt":124,"createdBy":85,"updatedBy":125,"centroid":126,"wellCount":22,"surveyCount":22},"zone-tx-02","TX-02","臺西盆地中區鹽水層","Taixi Basin Central Saline Aquifer","assessing","觀音山砂岩","打鹿頁岩",2750,650,17.8,95,1320,"臺西盆地中段的中新世砂岩儲集層，尚待補充震測資料確認蓋層連續性。","本區儲集層為觀音山砂岩，蓋層為打鹿頁岩。既有資料以 1980 年代油氣探勘震測為主，解析度有限，目前列為評估中，待新一期二維震測補測後更新容量估算。",{"type":60,"coordinates":105},[106],[107,110,113,116,119,122],[108,109],119.88,23.8,[111,112],120.2,23.78,[114,115],120.26,24.12,[117,118],119.96,24.14,[120,121],119.84,23.98,[108,109],"2022-03-14T02:10:00Z","2026-04-18T01:20:00Z","u-003",{"lng":127,"lat":128},120.05000000000001,23.96,{"id":130,"code":131,"name":132,"nameEn":133,"type":12,"status":94,"setting":46,"region":28,"basin":134,"reservoirFormation":135,"caprockFormation":136,"depthTopM":137,"depthBottomM":138,"thicknessM":139,"porosityPct":140,"permeabilityMd":141,"capacityMtCo2":29,"capacityMethod":55,"areaKm2":142,"summary":143,"description":144,"geometry":145,"publishStatus":82,"createdAt":164,"updatedAt":165,"createdBy":85,"updatedBy":85,"centroid":166,"wellCount":22,"surveyCount":22},"zone-tn-01","TN-01","臺南盆地西南海域鹽水層","Tainan Basin Southwest Offshore Saline Aquifer","臺南盆地","南莊層砂岩","古亭坑層",2400,3100,700,15.6,70,960,"南部海域潛力區，古亭坑層泥岩厚度大、封閉性佳，惟構造活動性需進一步評估。","本區位於臺南盆地西南側海域，蓋層古亭坑層為厚層泥岩，區域封閉性優良。惟鄰近區域斷層與泥貫入體發育，須以三維震測與地震活動度分析確認構造穩定性後方能提升評估等級。",{"type":60,"coordinates":146},[147],[148,150,153,156,158,161,163],[76,149],22.7,[151,152],120.25,22.68,[154,155],120.32,22.95,[73,157],23.22,[159,160],119.92,23.18,[108,162],22.9,[76,149],"2023-02-27T01:00:00Z","2026-03-09T03:15:00Z",{"lng":167,"lat":155},120.1,{"id":169,"code":170,"name":171,"nameEn":172,"type":12,"status":94,"setting":46,"region":31,"basin":47,"reservoirFormation":48,"caprockFormation":49,"depthTopM":173,"depthBottomM":174,"thicknessM":175,"porosityPct":176,"permeabilityMd":177,"capacityMtCo2":32,"capacityMethod":55,"areaKm2":178,"summary":179,"description":180,"geometry":181,"publishStatus":82,"createdAt":196,"updatedAt":197,"createdBy":85,"updatedBy":85,"centroid":198,"wellCount":22,"surveyCount":22},"zone-tc-01","TC-01","臺中港外海鹽水層","Taichung Port Offshore Saline Aquifer",1950,2500,550,19.1,120,410,"鄰近臺中港工業區排放源，運輸距離短，為近岸海域的優先評估區。","本區位於臺中港西側近岸海域，鄰近大型排放源，具備管線運輸優勢。儲集層與彰濱場址同屬桂竹林層，2022 年完成二維震測補測，目前進行構造解釋與容量評估。",{"type":60,"coordinates":182},[183],[184,186,189,191,193,195],[185,65],120.3,[187,188],120.48,24.22,[190,80],120.5,[154,192],24.48,[70,194],24.35,[185,65],"2022-11-08T06:00:00Z","2026-05-30T02:45:00Z",{"lng":199,"lat":200},120.39,24.34,{"id":202,"code":203,"name":204,"nameEn":205,"type":12,"status":206,"setting":207,"region":34,"basin":47,"reservoirFormation":48,"caprockFormation":49,"depthTopM":208,"depthBottomM":209,"thicknessM":139,"porosityPct":210,"permeabilityMd":211,"capacityMtCo2":35,"capacityMethod":212,"areaKm2":213,"summary":214,"description":215,"geometry":216,"publishStatus":82,"createdAt":232,"updatedAt":9,"createdBy":85,"updatedBy":85,"centroid":233,"wellCount":236,"surveyCount":237},"zone-ch-01","CH-01","彰濱鹽水層試驗場址","Changbin Saline Aquifer Pilot Site","pilot","mixed",2350,3050,16.2,60,"體積法（場址尺度，效率係數 4%）",32,"陸域小規模注儲試驗場址，已完成探勘井與監測井，具完整岩心與井測資料。","彰濱試驗場址位於彰化沿海工業區，目標儲集層為桂竹林層砂岩，頂深約 2,350 公尺。場址已完成一口探勘井（CHB-1）與一口監測井（CHB-2），取得完整岩心試驗、井測與三維震測資料，並建立地下水與土壤氣體監測基線，作為後續小規模注儲試驗之依據。",{"type":60,"coordinates":217},[218],[219,222,225,227,229,231],[220,221],120.36,24.07,[223,224],120.44,24.06,[226,115],120.46,[228,68],120.4,[230,115],120.35,[220,221],"2021-09-01T03:00:00Z",{"lng":234,"lat":235},120.405,24.104999999999997,3,4,{"id":239,"code":240,"name":241,"nameEn":242,"type":16,"status":206,"setting":243,"region":37,"basin":244,"reservoirFormation":245,"caprockFormation":246,"depthTopM":247,"depthBottomM":248,"thicknessM":52,"porosityPct":249,"permeabilityMd":250,"capacityMtCo2":251,"capacityMethod":252,"areaKm2":253,"summary":254,"description":255,"geometry":256,"publishStatus":82,"createdAt":271,"updatedAt":272,"createdBy":85,"updatedBy":85,"centroid":273,"wellCount":17,"surveyCount":17},"zone-ml-01","ML-01","鐵砧山枯竭氣田","Tiehchenshan Depleted Gas Field","onshore","西部麓山帶","木山層","大寮層頁岩",2800,3600,12.4,25,9,"物質平衡法（依累積產氣量推估）",18,"已開發多年的陸域氣田，構造封閉性經長期生產驗證，適合作為注儲試驗場址。","鐵砧山氣田為背斜構造封閉，儲集層為漸新世至中新世木山層砂岩，蓋層為大寮層頁岩。氣田歷經數十年生產，構造封閉性已獲驗證，且既有井場與管線設施可再利用，作為 CO₂ 注儲試驗場址具成本優勢。",{"type":60,"coordinates":257},[258],[259,262,264,267,270],[260,261],120.65,24.44,[263,261],120.72,[265,266],120.73,24.5,[268,269],120.66,24.51,[260,261],"2021-09-01T03:10:00Z","2026-07-11T08:00:00Z",{"lng":274,"lat":275},120.69,24.475,{"id":277,"code":278,"name":279,"nameEn":280,"type":16,"status":45,"setting":243,"region":37,"basin":244,"reservoirFormation":245,"caprockFormation":96,"depthTopM":51,"depthBottomM":23,"thicknessM":281,"porosityPct":282,"permeabilityMd":253,"capacityMtCo2":283,"capacityMethod":252,"areaKm2":284,"summary":285,"description":286,"geometry":287,"publishStatus":82,"createdAt":302,"updatedAt":303,"createdBy":85,"updatedBy":85,"centroid":304,"wellCount":22,"surveyCount":307},"zone-ml-02","ML-02","永和山氣田","Yunghoshan Gas Field",600,11.8,6,14,"陸域枯竭氣田，儲量規模小但地質資料完整，可作為監測技術驗證場址。","永和山氣田位於苗栗頭份至造橋一帶，為狹長背斜構造。氣田已進入枯竭階段，既有鑽井資料完整，適合驗證注儲監測技術；惟儲存容量有限，定位為技術驗證而非商業規模場址。",{"type":60,"coordinates":288},[289],[290,293,295,298,301],[291,292],120.83,24.61,[294,292],120.9,[296,297],120.91,24.67,[299,300],120.84,24.68,[291,292],"2022-01-20T02:00:00Z","2025-12-03T06:40:00Z",{"lng":305,"lat":306},120.87,24.645,0,{"id":309,"code":310,"name":311,"nameEn":312,"type":12,"status":313,"setting":243,"region":314,"basin":315,"reservoirFormation":316,"caprockFormation":317,"depthTopM":281,"depthBottomM":318,"thicknessM":319,"porosityPct":320,"permeabilityMd":52,"capacityMtCo2":307,"capacityMethod":321,"areaKm2":322,"summary":323,"description":324,"geometry":325,"publishStatus":82,"createdAt":340,"updatedAt":341,"createdBy":85,"updatedBy":125,"centroid":342,"wellCount":22,"surveyCount":307},"zone-pt-01","PT-01","屏東平原鹽水層","Pingtung Plain Saline Aquifer","excluded","屏東縣","屏東平原","沖積層下部砂層","無連續蓋層",900,300,24,"不適用（已排除）",210,"因儲集層深度不足、缺乏連續蓋層且鄰近活動斷層與地下水補注區，經評估排除。","屏東平原地下含水層雖孔隙率高，但深度不足 800 公尺、缺乏區域性連續蓋層，且鄰近潮州斷層與重要地下水補注區，經初步篩選評估排除。本資料保留以供篩選準則透明化參考。",{"type":60,"coordinates":326},[327],[328,331,333,335,337,339],[329,330],120.45,22.45,[332,330],120.6,[334,152],120.62,[187,336],22.72,[223,338],22.58,[329,330],"2022-06-15T02:00:00Z","2023-01-10T08:00:00Z",{"lng":343,"lat":344},120.53,22.585,100,8,{"items":348,"page":22,"pageSize":236,"total":283},[349,362,372],{"id":350,"slug":351,"title":352,"category":353,"publishedAt":354,"summary":355,"content":356,"pinned":357,"tags":358},"news-0006","2026-changbin-pilot-injection-plan","彰濱鹽水層試驗場址注儲試驗規劃說明會","event","2026-08-25T02:00:00Z","本中心將於 9 月 20 日於彰化縣線西鄉舉辦說明會，說明彰濱試驗場址的注儲試驗規劃、監測機制與民眾參與管道。","\u003Cp>為使地方民眾了解彰濱鹽水層試驗場址的規劃內容，本中心將於 115 年 9 月 20 日（星期日）上午 10 時，於彰化縣線西鄉公所三樓會議室舉辦說明會。\u003C\u002Fp>\u003Cp>說明會將介紹：\u003C\u002Fp>\u003Cul>\u003Cli>地質碳封存原理與國際案例\u003C\u002Fli>\u003Cli>彰濱場址地質條件與安全評估結果\u003C\u002Fli>\u003Cli>注儲試驗期間之地下水、土壤氣體與微震監測機制\u003C\u002Fli>\u003Cli>民眾意見反映管道\u003C\u002Fli>\u003C\u002Ful>\u003Cp>歡迎地方民眾踴躍參加，無需事先報名。\u003C\u002Fp>",true,[359,360,361],"彰濱","說明會","注儲試驗",{"id":363,"slug":364,"title":365,"category":366,"publishedAt":84,"summary":367,"content":368,"pinned":369,"tags":370},"news-0005","2026-tx01-capacity-update","臺西盆地北區潛力區封存容量評估更新","announcement","依據 2019 年二維震測重新解釋成果，臺西盆地北區鹽水層封存潛力更新為 3,200 百萬公噸。","\u003Cp>本中心完成臺西盆地北區（TX-01）二維震測資料重新解釋，儲集層桂竹林層砂岩分布範圍較先前評估擴大約 12%，封存潛力由 2,850 百萬公噸更新為 3,200 百萬公噸。\u003C\u002Fp>\u003Cp>本次評估採用美國能源部（US DOE）體積法，效率係數取 2%。詳細評估方法與參數請參閱資料下載專區之技術報告。\u003C\u002Fp>",false,[47,371],"容量評估",{"id":373,"slug":374,"title":375,"category":376,"publishedAt":377,"summary":378,"content":379,"pinned":369,"tags":380},"news-0004","2026-platform-launch","地質碳封存潛力區位資訊平臺正式上線","press","2026-03-01T01:00:00Z","整合全國地質碳封存潛力區調查與試驗資料，提供民眾查詢潛力區位置、地質條件與相關文件。","\u003Cp>地質碳封存潛力區位資訊平臺今日正式上線，整合歷年油氣探勘與碳封存專案累積之井位、震測、岩心試驗等資料，並以互動式地圖呈現各潛力區之空間分布。\u003C\u002Fp>\u003Cp>平臺依資料公開原則，於完成審核後陸續發布各潛力區之評估結果；涉及第三方權益之原始資料則依規定申請取得。\u003C\u002Fp>",[381,382],"平臺","上線",1790843882561]
[{"data":1,"prerenderedAt":37},["ShallowReactive",2],{"news-2025-yunlin-offshore-survey-start":3,"news-order":15},{"id":4,"slug":5,"title":6,"category":7,"publishedAt":8,"summary":9,"content":10,"pinned":11,"tags":12},"news-0002","2025-yunlin-offshore-survey-start","雲林外海二維震測補測作業啟動","announcement","2025-10-01T02:00:00Z","為評估雲林外海鹽水層封存潛力，本中心自 10 月起於雲林離島工業區西側海域進行二維震測作業。","\u003Cp>本中心委託執行之雲林外海二維震測作業自 114 年 10 月 1 日起展開，預計 12 月底完成資料採集。作業期間震測船將於雲林外海 5 至 25 公里海域施作，請航行船隻注意避讓。\u003C\u002Fp>\u003Cp>震測資料處理與解釋預計於 115 年第三季完成，屆時將更新潛力區評估資訊。\u003C\u002Fp>",false,[13,14],"雲林外海","震測",[16,20,24,28,32,33],{"slug":17,"title":18,"publishedAt":19},"2026-changbin-pilot-injection-plan","彰濱鹽水層試驗場址注儲試驗規劃說明會","2026-08-25T02:00:00Z",{"slug":21,"title":22,"publishedAt":23},"2026-tx01-capacity-update","臺西盆地北區潛力區封存容量評估更新","2026-06-02T07:30:00Z",{"slug":25,"title":26,"publishedAt":27},"2026-platform-launch","地質碳封存潛力區位資訊平臺正式上線","2026-03-01T01:00:00Z",{"slug":29,"title":30,"publishedAt":31},"2025-tiehchenshan-monitoring-report","鐵砧山注儲試驗場址 2025 年度監測報告發布","2025-12-15T03:00:00Z",{"slug":5,"title":6,"publishedAt":8},{"slug":34,"title":35,"publishedAt":36},"2025-ccs-open-data-release","潛力區地質資料開放下載","2025-06-10T02:00:00Z",1790843882613]
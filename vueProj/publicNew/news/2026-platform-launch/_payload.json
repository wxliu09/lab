[{"data":1,"prerenderedAt":37},["ShallowReactive",2],{"news-2026-platform-launch":3,"news-order":15},{"id":4,"slug":5,"title":6,"category":7,"publishedAt":8,"summary":9,"content":10,"pinned":11,"tags":12},"news-0004","2026-platform-launch","地質碳封存潛力區位資訊平臺正式上線","press","2026-03-01T01:00:00Z","整合全國地質碳封存潛力區調查與試驗資料，提供民眾查詢潛力區位置、地質條件與相關文件。","\u003Cp>地質碳封存潛力區位資訊平臺今日正式上線，整合歷年油氣探勘與碳封存專案累積之井位、震測、岩心試驗等資料，並以互動式地圖呈現各潛力區之空間分布。\u003C\u002Fp>\u003Cp>平臺依資料公開原則，於完成審核後陸續發布各潛力區之評估結果；涉及第三方權益之原始資料則依規定申請取得。\u003C\u002Fp>",false,[13,14],"平臺","上線",[16,20,24,25,29,33],{"slug":17,"title":18,"publishedAt":19},"2026-changbin-pilot-injection-plan","彰濱鹽水層試驗場址注儲試驗規劃說明會","2026-08-25T02:00:00Z",{"slug":21,"title":22,"publishedAt":23},"2026-tx01-capacity-update","臺西盆地北區潛力區封存容量評估更新","2026-06-02T07:30:00Z",{"slug":5,"title":6,"publishedAt":8},{"slug":26,"title":27,"publishedAt":28},"2025-tiehchenshan-monitoring-report","鐵砧山注儲試驗場址 2025 年度監測報告發布","2025-12-15T03:00:00Z",{"slug":30,"title":31,"publishedAt":32},"2025-yunlin-offshore-survey-start","雲林外海二維震測補測作業啟動","2025-10-01T02:00:00Z",{"slug":34,"title":35,"publishedAt":36},"2025-ccs-open-data-release","潛力區地質資料開放下載","2025-06-10T02:00:00Z",1790843882613]